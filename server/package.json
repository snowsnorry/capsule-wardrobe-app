{
  "name": "capsule-wardrobe-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx src/index.ts",
    "dev:test-auth": "AUTH_TEST_MODE=true NODE_ENV=development tsx src/index.ts",
    "dev:e2e": "E2E_SERVER=true AUTH_TEST_MODE=true NODE_ENV=development VITE_API_BASE_URL=/ VITE_GOOGLE_CLIENT_ID=e2e-google-client VITE_THUMBNAIL_ASSET_BASE_URL=/__e2e/thumbnails tsx src/e2e/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/server/src dist/server/src/db dist/server/src/ai && cp -R src/templates dist/server/src/templates && cp -R src/db/sql dist/server/src/db/sql && cp -R src/ai/sql dist/server/src/ai/sql",
    "start": "node ./dist/server/src/index.js",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@aws-sdk/client-s3": "^3.1057.0",
    "@fontsource/dm-sans": "^5.0.18",
    "@google/genai": "^2.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neondatabase/serverless": "^1.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@simplewebauthn/server": "^13.3.1",
    "better-sse": "^0.16.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "file-type": "^22.0.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.2.0",
    "impers": "^0.0.6",
    "multer": "^2.1.1",
    "mustache": "^4.2.0",
    "ollama": "^0.6.3",
    "openai": "^6.39.1",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.22.4",
    "vite": "^8.0.16",
    "vitest": "^4.1.2"
  }
}
