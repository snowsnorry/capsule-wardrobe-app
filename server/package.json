{
  "name": "capsule-wardrobe-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx src/index.ts",
    "dev:test-auth": "AUTH_TEST_MODE=true NODE_ENV=development tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prestart": "npm run build",
    "start": "node ./dist/server/src/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@fontsource/dm-sans": "^5.0.18",
    "@google/genai": "^1.42.0",
    "@neondatabase/serverless": "^0.10.4",
    "@pdf-lib/fontkit": "^1.1.1",
    "better-sse": "^0.16.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "link-preview-js": "^4.0.0",
    "ollama": "^0.6.3",
    "openai": "^4.104.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.5",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  }
}
