{
  "name": "capsule-wardrobe-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx src/index.ts",
    "dev:test-auth": "AUTH_TEST_MODE=true NODE_ENV=development tsx src/index.ts",
    "dev:e2e": "E2E_SERVER=true AUTH_TEST_MODE=true NODE_ENV=development VITE_API_BASE_URL=/ VITE_THUMBNAIL_ASSET_BASE_URL=/__e2e/thumbnails tsx src/e2e/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/server/src && cp -R src/templates dist/server/src/templates",
    "start": "node ./dist/server/src/index.js",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@aws-sdk/client-s3": "^3.1037.0",
    "@fontsource/dm-sans": "^5.0.18",
    "@google/genai": "^1.42.0",
    "@neondatabase/serverless": "^0.10.4",
    "@pdf-lib/fontkit": "^1.1.1",
    "@simplewebauthn/server": "^13.3.0",
    "better-sse": "^0.16.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.0.0",
    "mustache": "^4.2.0",
    "ollama": "^0.6.3",
    "openai": "^4.104.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.5",
    "yaml": "^2.8.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mustache": "^4.2.6",
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0",
    "@vitest/coverage-v8": "^4.1.5",
    "vite": "^8.0.11",
    "vitest": "^4.1.2"
  }
}
