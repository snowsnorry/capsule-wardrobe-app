# Postgres connection string:
DATABASE_URL=postgresql://<user>:<password>@<endpoint>/<database>?sslmode=require

# Secret for HMAC hashing login codes.
AUTH_CODE_SECRET=replace-with-a-long-random-secret
# Resend API key used to send login codes by email.
RESEND_API_KEY=re_xxxxxxxxx
# Verified sender in Resend, e.g. "Capsule Wardrobe <auth@yourdomain.com>".
RESEND_FROM_EMAIL=Capsule Wardrobe <onboarding@resend.dev>
# Google OAuth Web Client ID used to verify Google Sign-In id_token.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# OpenAI API key used for final wardrobe selection.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Voyage API key used for embeddings and wardrobe prompt generation.
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DeepInfra API key used for DeepInfra-backed generation flows.
DEEPINFRA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Gemini API key used for Google Gemini text and image generation flows.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxx-xxxxxxx-xxxxxxxxx
# Anthropic API key used for Claude-backed generation flows.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxx
# Cloudflare R2 bucket for generated outfit set images.
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=capsule-wardrobe-images
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public bucket/custom-domain origin used to store direct image URLs in capsule JSON.
R2_PUBLIC_BASE_URL=https://images.example.com
# Optional object key prefix for generated and migrated images.
R2_IMAGE_KEY_PREFIX=outfit-set-images
# Minimum interval between session cleanup runs in milliseconds.
# Default 0 means cleanup on each session read/write.
SESSION_PRUNE_MIN_INTERVAL_MS=0
# Optional local/test mode: do not send sign-in codes by email, print them to server logs instead.
# Ignored in production.
AUTH_TEST_MODE=false
# Passkey/WebAuthn relying party host. Use the hostname users see in the browser.
# Custom domain example: PASSKEY_RP_ID=app.yourdomain.com
PASSKEY_RP_ID=app.yourdomain.com
# Passkey/WebAuthn expected browser origin. Must match the visible frontend origin exactly.
# Include protocol, omit path and trailing slash.
# Custom domain example: PASSKEY_ORIGIN=https://app.yourdomain.com
PASSKEY_ORIGIN=https://app.yourdomain.com

PORT=3000
# Frontend origin allowed for cross-origin auth requests in non-development environments.
# For passkeys this usually matches PASSKEY_ORIGIN.
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
