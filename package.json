{
  "name": "capsule-wardrobe-app",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "npm --workspace client run build && npm --workspace server run build",
    "start": "npm --workspace server run start",
    "start:render": "npm --workspace server run start",
    "start:client:render": "npm --workspace client run start:render",
    "prune:expired-records": "npm --workspace server run prune:expired-records",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "dev:all": "concurrently -k -n client,server \"npm:dev:client\" \"npm:dev:server\"",
    "dev:server:test-auth": "npm --workspace server run dev:test-auth",
    "playwright:install": "playwright install",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "npm run typecheck:client && npm run typecheck:server && npm run typecheck:shared",
    "typecheck:client": "npm --workspace client run typecheck",
    "typecheck:server": "npm --workspace server run typecheck",
    "typecheck:shared": "tsc -p shared/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:client": "vitest run --project client",
    "test:server": "vitest run --project server",
    "test:shared": "vitest run --project shared",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "quality:large-files": "find client/src server/src shared -type f \\( -name \"*.ts\" -o -name \"*.tsx\" -o -name \"*.js\" -o -name \"*.jsx\" \\) -not -path \"*/node_modules/*\" -not -path \"*/dist/*\" -not -path \"*/build/*\" -exec wc -l {} + | sort -nr | head -40",
    "quality:large-files:strict": "node scripts/check-large-files.mjs",
    "quality:deps": "depcruise client/src server/src shared --config .dependency-cruiser.cjs",
    "quality:gate": "npm run lint:strict && npm run typecheck && npm run build && npm run coverage && npm run quality:deps && npm run quality:large-files:strict && npm run format:check && npm run quality:unused && npm run test:e2e",
    "quality": "npm run quality:gate && npm run quality:large-files",
    "coverage": "vitest run --coverage",
    "coverage:client": "vitest run --coverage --project client",
    "coverage:server": "vitest run --coverage --project server",
    "coverage:shared": "vitest run --coverage --project shared",
    "format": "prettier --write \"client/src/**/*.{ts,tsx,js,jsx,css,scss}\" \"server/src/**/*.{ts,tsx,js,jsx}\" \"shared/**/*.{ts,tsx,js,jsx}\" \"playwright.config.ts\" \"tests/e2e/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs,cjs}\"",
    "format:check": "prettier --check \"client/src/**/*.{ts,tsx,js,jsx,css,scss}\" \"server/src/**/*.{ts,tsx,js,jsx}\" \"shared/**/*.{ts,tsx,js,jsx}\" \"playwright.config.ts\" \"tests/e2e/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs,cjs}\"",
    "security:audit": "npm audit --audit-level=high",
    "quality:unused": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "sharp@0.34.5": true,
    "protobufjs@7.6.5": true,
    "@google/genai@2.18.0": true
  }
}
