# Base API URL used by client requests (optional in local dev with proxy).
VITE_API_BASE_URL=/api

# Public thumbnail URL prefix up to the generated filename.
VITE_THUMBNAIL_ASSET_BASE_URL=https://assets.capsule-wardrobe.org/thumbnails

# Google OAuth Web Client ID for Google Sign-In.
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Upstream server origin for the BFF function.
BFF_UPSTREAM_ORIGIN=http://localhost:3000
# Comma-separated path prefixes stripped by the BFF before proxying.
BFF_STRIP_PREFIXES=/api
